# Legacy MSSQL Database Configuration (Preserved for Rollback & Data Migration)
DB_SERVER=10.2.13.102
DB_DATABASE=digiseva
DB_USER=sysgrp
DB_PASSWORD=sysgrp
DB_ENCRYPT=true
DB_TRUST_CERT=true
# Server name for TLS to avoid IP address warning
DB_SERVER_NAME=bhel-sql-server

# Database Configuration (Alternative - MSSQL_ prefix for standardization)
MSSQL_SERVER=10.2.13.102
MSSQL_PORT=1433
MSSQL_DATABASE=digiseva
MSSQL_USER=sysgrp
MSSQL_PASSWORD=sysgrp
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_SERVER_NAME=bhel-sql-server

# Security Configuration
JWT_SECRET=bhel-transport-super-secure-jwt-secret-key-change-in-production-2024!@#$%^&*()
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=bhel-session-super-secure-secret-key-change-in-production-2024!@#$%^&*()

# Password Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_UPPERCASE=true

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Application Environment
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
