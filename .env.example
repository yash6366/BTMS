# ============================================================================
# BHEL TRANSPORT MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# ============================================================================

# Primary Neon PostgreSQL Connection URL
DATABASE_URL=postgresql://username:password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security & Session Secrets
JWT_SECRET=your-jwt-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-key-change-in-production

# Password Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_UPPERCASE=true

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Application Environment
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
